#     health_probe_path = "/health"
#     origins = {
#       primary = {
#         host_name = "myapp.azurewebsites.net"   # replace with your backend hostname
#       }
#     }
#   }
#
#   # ── MULTI-COMPONENT: separate groups for frontend + API ───────────────
