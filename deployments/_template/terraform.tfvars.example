# =====================================================
# TERRAFORM VARIABLE VALUES
# Copy this file and rename to terraform.tfvars
# Update values for your specific customer/environment
# =====================================================

# =====================================================
# CORE SETTINGS (Always Required)
# =====================================================
customer_short_name = "contoso"        # 3-8 lowercase letters
environment         = "prod"           # prod, dev, staging, uat, test
location            = "eastus"         # Azure region
location_code       = "eus"            # Short region code
instance_number     = 1                # Instance number (typically 1)

# =====================================================
# SUBSCRIPTIONS
# Two Azure subscriptions — must be in the same Azure AD tenant.
# The Terraform identity needs Contributor on both subscriptions.
# =====================================================
landing_zone_subscription_id = "00000000-0000-0000-0000-000000000001"  # LZ sub: hub, shared KV, Log Analytics, Front Door
compute_subscription_id      = "00000000-0000-0000-0000-000000000002"  # Compute sub: ACA, AVD, databases, storage

# =====================================================
# TAGS
# =====================================================
tags = {
  Environment = "Production"
  ManagedBy   = "Terraform"
  Customer    = "Contoso"
  CostCenter  = "IT-Infrastructure"
}

# =====================================================
# MODULE CONTROL FLAGS
# =====================================================
# ── Landing Zone (landing_zone_subscription_id) ──────
enable_hub_networking    = true   # Hub VNet in LZ subscription
enable_shared_key_vault  = false  # Shared KV for platform secrets (AVD creds, certs)
enable_shared_monitoring = false  # Centralised Log Analytics workspace

# ── Compute (compute_subscription_id) ────────────────
enable_spoke_networking = true  # Spoke VNet in Compute subscription

# =====================================================
# STORAGE ACCOUNTS (Compute subscription)
# =====================================================
storage_accounts = {
  data = {
    tier             = "Standard"
    replication_type = "LRS"
    blob_containers  = ["uploads", "processed", "archive"]
  }
  logs = {
    tier             = "Standard"
    replication_type = "LRS"
    blob_containers  = ["app-logs", "audit-logs", "diagnostics"]
  }
  backups = {
    tier             = "Standard"
    replication_type = "GRS"  # Geo-redundant for backups
    blob_containers  = ["sql-backups", "vm-snapshots"]
  }
}

# =====================================================
# KEY VAULTS (Compute subscription)
# =====================================================
key_vaults = {
  secrets = {
    sku_name    = "standard"
    enable_rbac = true
  }
  certs = {
    sku_name    = "premium"  # Premium for HSM-backed certificates
    enable_rbac = true
  }
}

# =====================================================
# SQL DATABASES (Compute subscription)
# =====================================================
sql_databases = {
  orders = {
    admin_username = "sqladmin"
    admin_password = "ChangeMe123!SecurePassword"  # Use Key Vault reference in production
    database_name  = "OrdersDB"
    sku_name       = "S1"
    max_size_gb    = 250
    zone_redundant = false
  }
  inventory = {
    admin_username = "sqladmin"
    admin_password = "ChangeMe123!SecurePassword"
    database_name  = "InventoryDB"
    sku_name       = "S2"
    max_size_gb    = 500
    zone_redundant = true
  }
}

# =====================================================
# OPTIONAL MODULE FLAGS
# =====================================================
enable_virtual_machine    = false
enable_app_service        = false
enable_front_door         = false   # Azure Front Door + WAF (LZ subscription)
enable_redis_cache        = false
enable_avd                = false   # Azure Virtual Desktop (Compute subscription)
enable_aca                = false   # Azure Container Apps (Compute subscription)
enable_container_registry = false   # Azure Container Registry (for ACA)
enable_waf                = true    # WAF on Front Door (only when enable_front_door = true)

# =====================================================
# HUB NETWORKING (Landing Zone subscription)
# Customize address spaces and subnets as needed.
# GatewaySubnet and AzureFirewallSubnet skip NSG attachment automatically.
# =====================================================
hub_vnet_address_space = ["10.100.0.0/16"]

hub_subnets = {
  GatewaySubnet = {
    address_prefix = "10.100.0.0/27"  # /27 minimum for VPN/ER gateway
    name           = "GatewaySubnet"   # Azure requires this exact name
  }
  management = {
    address_prefix = "10.100.1.0/24"
  }
  # ── Add AzureFirewallSubnet when enabling Azure Firewall ──
  # AzureFirewallSubnet = {
  #   address_prefix = "10.100.2.0/26"   # /26 minimum for Azure Firewall
  #   name           = "AzureFirewallSubnet"
  # }
  # ── Add AzureBastionSubnet when enabling Azure Bastion ──
  # AzureBastionSubnet = {
  #   address_prefix = "10.100.3.0/26"
  #   name           = "AzureBastionSubnet"
  # }
}

# =====================================================
# SPOKE NETWORKING (Compute subscription)
# =====================================================
spoke_vnet_address_space = ["10.0.0.0/16"]

spoke_subnets = {
  gateway = {
    address_prefix = "10.0.0.0/24"
  }
  appservice = {
    address_prefix = "10.0.1.0/24"
  }
  vms = {
    address_prefix = "10.0.2.0/24"
  }
  data = {
    address_prefix = "10.0.3.0/24"
  }
  mgmt = {
    address_prefix = "10.0.255.0/24"
  }
  # ── Add these subnets when enable_avd = true ──
  # avd-general = {
  #   address_prefix = "10.0.10.0/23"   # /23 = 512 addresses — supports ~50+ session hosts
  # }
  # avd-power = {
  #   address_prefix = "10.0.12.0/24"
  # }
  # avd-personal = {
  #   address_prefix = "10.0.13.0/24"
  # }
  # ── Add this subnet when enable_aca = true with VNet integration ──
  # aca = {
  #   address_prefix = "10.0.20.0/23"   # /23 minimum for ACA; must have Microsoft.App/environments delegation
  #   delegation = {
  #     name    = "aca-delegation"
  #     service = "Microsoft.App/environments"
  #     actions = ["Microsoft.Network/virtualNetworks/subnets/join/action"]
  #   }
  # }
}

# =====================================================
# VIRTUAL MACHINE CONFIGURATION (if enabled)
# =====================================================
# vm_size           = "Standard_D2s_v3"
# vm_admin_username = "azureadmin"

# =====================================================
# APP SERVICE CONFIGURATION (if enabled)
# =====================================================
# app_service_sku_name = "P1v2"  # B1, S1, P1v2, P2v2, etc.

